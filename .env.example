# Development defaults to fixtures when this is omitted. API URLs must use HTTPS
# in production; development HTTP is allowed only for localhost/127.0.0.1/[::1].
EXPO_PUBLIC_CHOONZ_MODE=fixtures
EXPO_PUBLIC_CHOONZ_API_BASE_URL=

# Browser/mobile-safe Supabase configuration only. Supabase URLs follow the same
# HTTPS/loopback rule. The preferred public key must begin sb_publishable_. Never
# put a service-role, secret, database password, or private value in EXPO_PUBLIC_*.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional compatibility fallback: a decodable legacy JWT with role exactly anon.
# Prefer the publishable key above; an invalid primary key never falls back here.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
