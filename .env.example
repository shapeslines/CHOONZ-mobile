# Development defaults to fixtures when this is omitted. Set api only with a public API URL.
EXPO_PUBLIC_CHOONZ_MODE=fixtures
EXPO_PUBLIC_CHOONZ_API_BASE_URL=

# Browser/mobile-safe Supabase configuration only. Never put a service-role, secret,
# database password, or other private value in an EXPO_PUBLIC_* variable.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional compatibility fallback for a legacy Supabase anon key. Prefer the
# publishable key above and leave this blank for new projects.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
